---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
---

<BaseLayout title="プロフィール | ひまわりブログ" description="ひまわりブログ管理人のプロフィール">
  <div class="page-grid">
    <main class="main-content">
      <div class="profile-page">
        <h1 class="profile-page__title">プロフィール</h1>

        <div class="profile-card">
          <img
            src="https://picsum.photos/seed/himawari-profile-large/400/400"
            alt="ひまわり"
            class="profile-card__avatar"
            width="200"
            height="200"
          />
          <div class="profile-card__content">
            <h2 class="profile-card__name">ひまわり</h2>
            <p class="profile-card__bio">
              暮らしを整えることが、人生を整えること。<br />
              50代の今、片付けや収納、季節の花、心がときめく手づくり…<br />
              毎日のなかで見つけた『ちいさな幸せ』を綴ります。
            </p>
          </div>
        </div>

        <section class="profile-section">
          <h3 class="profile-section__title">このブログについて</h3>
          <div class="prose">
            <p>
              子育てもひと段落した人生後半だからこそ、本当に好きなもの、心が満たされるものに囲まれた暮らしを。
            </p>
            <p>
              片付けや収納の工夫、季節の花、心がときめく手づくり…毎日のなかで見つけた『ちいさな幸せ』を綴るブログです。
            </p>
            <p>
              楽天で出会った好きなものとの暮らしも自然にご紹介しながら、一緒に『心地よい毎日』を探してみませんか？
            </p>
          </div>
        </section>

        <section class="profile-section">
          <h3 class="profile-section__title">好きなもの</h3>
          <ul class="interests-list">
            <li class="interests-item">
              <span class="interests-emoji">🌻</span>
              <span>お花（特にひまわり）</span>
            </li>
            <li class="interests-item">
              <span class="interests-emoji">📚</span>
              <span>読書</span>
            </li>
            <li class="interests-item">
              <span class="interests-emoji">🧵</span>
              <span>手作り・DIY</span>
            </li>
            <li class="interests-item">
              <span class="interests-emoji">🏠</span>
              <span>インテリア・整理整頓</span>
            </li>
            <li class="interests-item">
              <span class="interests-emoji">🍵</span>
              <span>季節のお取り寄せ</span>
            </li>
            <li class="interests-item">
              <span class="interests-emoji">✈️</span>
              <span>旅行</span>
            </li>
          </ul>
        </section>

        <section class="profile-section">
          <h3 class="profile-section__title">SNS・その他</h3>
          <div class="sns-links">
            <a href="#" class="sns-link sns-link--ig">
              <span class="sns-link__icon">📷</span>
              <span class="sns-link__label">Instagram</span>
            </a>
            <a href="#" class="sns-link sns-link--x">
              <span class="sns-link__icon">𝕏</span>
              <span class="sns-link__label">X（Twitter）</span>
            </a>
            <a href="https://room.rakuten.co.jp/room_fa8b7849f1/items" target="_blank" class="sns-link sns-link--room">
              <span class="sns-link__icon">🛁</span>
              <span class="sns-link__label">楽天ROOM</span>
            </a>
            <a href="/contact" class="sns-link sns-link--contact">
              <span class="sns-link__icon">✉️</span>
              <span class="sns-link__label">お問い合わせ</span>
            </a>
          </div>
        </section>
      </div>
    </main>

    <Sidebar />
  </div>
</BaseLayout>

<style>
  .profile-page {
    margin-bottom: 3rem;
  }

  .profile-page__title {
    font-size: 2rem;
    font-weight: 600;
    margin-bottom: 2rem;
    text-align: center;
    color: var(--color-text-dark);
  }

  .profile-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    background: linear-gradient(135deg, rgba(244, 196, 48, 0.05) 0%, rgba(184, 220, 200, 0.05) 100%);
    padding: 2rem;
    border-radius: 12px;
    margin-bottom: 2.5rem;
  }

  .profile-card__avatar {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    border: 4px solid var(--color-primary);
    object-fit: cover;
  }

  .profile-card__name {
    font-size: 1.8rem;
    font-weight: 600;
    text-align: center;
    color: var(--color-text-dark);
    margin-bottom: 0.5rem;
  }

  .profile-card__bio {
    font-size: 1rem;
    line-height: 1.7;
    text-align: center;
    color: var(--color-text-main);
  }

  .profile-section {
    margin-bottom: 2.5rem;
  }

  .profile-section__title {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--color-text-dark);
    margin-bottom: 1.2rem;
    padding-bottom: 0.5rem;
    border-bottom: 3px solid var(--color-primary);
  }

  .interests-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
  }

  .interests-item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem;
    background-color: var(--color-bg-light);
    border-radius: 8px;
    font-size: 0.95rem;
    color: var(--color-text-main);
  }

  .interests-emoji {
    font-size: 1.5rem;
  }

  .sns-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
  }

  .sns-link {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1rem;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 500;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .sns-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(244, 196, 48, 0.3);
  }

  .sns-link__icon {
    font-size: 1.5rem;
  }

  .sns-link--ig {
    background: linear-gradient(135deg, #E1306C 0%, #E1306C 100%);
  }

  .sns-link--x {
    background: linear-gradient(135deg, #000 0%, #1a1a1a 100%);
  }

  .sns-link--room {
    background: linear-gradient(135deg, #BF0000 0%, #8B0000 100%);
  }

  .sns-link--contact {
    background: linear-gradient(135deg, var(--color-accent) 0%, #d17a7a 100%);
  }

  @media (max-width: 640px) {
    .profile-page__title {
      font-size: 1.5rem;
    }

    .profile-card {
      padding: 1.5rem;
      gap: 1rem;
    }

    .profile-card__avatar {
      width: 150px;
      height: 150px;
    }

    .profile-card__name {
      font-size: 1.4rem;
    }

    .interests-list,
    .sns-links {
      grid-template-columns: 1fr;
    }
  }
</style>
