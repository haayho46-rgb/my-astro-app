---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

// ページネーション設定
const postsPerPage = 10;
const currentPage = 1;
const totalPages = Math.ceil(allPosts.length / postsPerPage);
const startIndex = (currentPage - 1) * postsPerPage;
const posts = allPosts.slice(startIndex, startIndex + postsPerPage);
---

<BaseLayout title="ひまわりブログ">
  <div class="page-grid">

    <main class="main-content">
      <p class="section-label">新着記事</p>
      <ul class="post-list post-list--grid">
        {posts.map((post) => {
          const slug = post.id.replace(/\.md$/, '');
          const dateStr = post.data.publishDate.toLocaleDateString('ja-JP', {
            year: 'numeric', month: 'long', day: 'numeric',
          });
          return (
            <li class="post-card">
              <a href={`/blog/${slug}`} class="post-card__image-wrap">
                {post.data.heroImage ? (
                  <img
                    src={post.data.heroImage}
                    alt={post.data.title}
                    class="post-card__image"
                    width="800"
                    height="450"
                    loading="lazy"
                  />
                ) : (
                  <div class="post-card__image post-card__image--placeholder">
                    🌻
                  </div>
                )}
              </a>
              <div class="post-card__body">
                {post.data.category && (
                  <span class="post-card__category">{post.data.category}</span>
                )}
                <h2 class="post-card__title">
                  <a href={`/blog/${slug}`}>{post.data.title}</a>
                </h2>
                <time class="post-card__date">{dateStr}</time>
                <p class="post-card__desc">{post.data.description}</p>
                <div class="post-card__footer">
                  <a href={`/blog/${slug}`} class="post-card__readmore">続きを読む →</a>
                </div>
              </div>
            </li>
          );
        })}
      </ul>

      <!-- ページネーション -->
      {totalPages > 1 && (
        <div class="pagination">
          <div class="pagination__items">
            {totalPages <= 5 ? (
              // ページ数が5以下の場合、全てのページを表示
              Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
                <a
                  href={page === 1 ? '/' : `/page/${page}`}
                  class={`pagination__item ${page === currentPage ? 'pagination__item--active' : ''}`}
                >
                  {page}
                </a>
              ))
            ) : (
              <>
                {/* 最初のページ */}
                <a href="/" class={`pagination__item ${currentPage === 1 ? 'pagination__item--active' : ''}`}>
                  1
                </a>

                {/* 前の3ページへのリンク */}
                {currentPage > 4 && <span class="pagination__ellipsis">...</span>}

                {/* 現在のページの前後 */}
                {Array.from(
                  { length: Math.min(5, totalPages - 2) },
                  (_, i) => Math.max(2, currentPage - 2) + i
                )
                  .filter((page) => page < totalPages)
                  .map((page) => (
                    <a
                      href={`/page/${page}`}
                      class={`pagination__item ${page === currentPage ? 'pagination__item--active' : ''}`}
                    >
                      {page}
                    </a>
                  ))}

                {/* 次の3ページへのリンク */}
                {currentPage < totalPages - 3 && <span class="pagination__ellipsis">...</span>}

                {/* 最後のページ */}
                <a
                  href={`/page/${totalPages}`}
                  class={`pagination__item ${currentPage === totalPages ? 'pagination__item--active' : ''}`}
                >
                  {totalPages}
                </a>
              </>
            )}
          </div>
        </div>
      )}
    </main>

    <Sidebar />

  </div>
</BaseLayout>
